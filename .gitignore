# secrets — never commit real values
.env
.env.*
!.env.example
secrets/*.local
secrets/*.json
!secrets/.gitkeep

# deps / build
node_modules/
dist/
*.log

# hidden local/runtime state (tracked project configuration stays visible)
.*
!.gitignore
!.dockerignore
!.env.example
!.github/
!.github/**

# runtime & test scratch data
data/
*.sqlite
*.sqlite-*
jeo-runtime-*/
artifacts/native-qualification/current/
